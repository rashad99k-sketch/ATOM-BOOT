# ================= RF LIQUIDITY PRO =================
# Start in PAPER mode. Add BingX credentials before LIVE mode.
BINGX_API_KEY=
BINGX_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PAPER_MODE=True
SYMBOL=BTC/USDT:USDT
INTERVAL=15m
LEVERAGE=10
PORT=8000

# ================= PORTFOLIO =================
MAX_OPEN_POSITIONS=6
POSITION_MARGIN_PCT=0.10
PORTFOLIO_MARGIN_CAP_PCT=0.60
MAX_POSITIONS_PER_ASSET_CLASS=2

# ================= DEEP MULTI-MARKET RADAR =================
DEEP_SCAN_ENABLED=True
DEEP_SCAN_INTERVAL_SEC=1200
GLOBAL_SCAN_INTERVAL_SEC=1200
DEEP_SCAN_RADAR_SYMBOLS=240
DEEP_SCAN_MAX_SYMBOLS=60
DEEP_WATCHLIST_SIZE=60
DEEP_SCAN_BATCH_SIZE=24
WATCHLIST_DEEP_BATCH_SIZE=10
WATCHLIST_DEEP_INTERVAL_SEC=10
WATCHLIST_SERVICE_INTERVAL_SEC=10
DEEP_MIN_SCORE=8

# Balanced discovery quotas. The live BingX market list is authoritative.
DEEP_SCAN_CRYPTO_QUOTA=10000
DEEP_SCAN_STOCK_QUOTA=10000
DEEP_SCAN_INDEX_QUOTA=10000
DEEP_SCAN_GOLD_QUOTA=10000
DEEP_SCAN_OIL_QUOTA=10000

# Optional explicit symbols. Only symbols actually exposed by BingX are used.
DEEP_SCAN_STOCK_SYMBOLS=AAPL/USDT:USDT,AMZN/USDT:USDT,GOOGL/USDT:USDT,MSFT/USDT:USDT,NVDA/USDT:USDT,META/USDT:USDT,TSLA/USDT:USDT,JPM/USDT:USDT,MU/USDT:USDT,PLTR/USDT:USDT
DEEP_SCAN_INDEX_SYMBOLS=US500/USDT:USDT,USTECH/USDT:USDT,US30/USDT:USDT,DAX/USDT:USDT,FTSE/USDT:USDT,NIKKEI/USDT:USDT
DEEP_SCAN_GOLD_SYMBOLS=GOLD(XAU)/USDT:USDT
DEEP_SCAN_OIL_SYMBOLS=OILWTI/USDT:USDT,OILBRENT/USDT:USDT

# ================= NEWS / EVENT RISK =================
NEWS_ENABLED=True
NEWS_RISK_BLOCK=80
NEWS_TIMEOUT_SEC=4
NEWS_CACHE_TTL_SEC=300
NEWS_MAX_ITEMS=8
NEWS_MAX_AGE_HOURS=24
NEWS_GLOBAL_QUERY=FOMC CPI inflation NFP Fed tariffs sanctions war crypto markets gold oil
NEWS_YAHOO_ENABLED=True
NEWS_RSS_ENABLED=True
NEWS_YAHOO_SEARCH_URL=https://query1.finance.yahoo.com/v1/finance/search
NEWS_RSS_FEEDS=https://news.google.com/rss/search?q={query}&hl=en-US&gl=US&ceid=US:en

# ================= EXECUTION QUEUE / RUNTIME =================
USE_EXECUTION_QUEUE=True
QUEUE_MAX_SIZE=15
QUEUE_RE_EVAL_INTERVAL=5
QUEUE_PROMOTE_INTERVAL=20
WATCHLIST_QUEUE_MIN_SCORE=8.0
WATCHLIST_QUEUE_MIN_NARRATIVE=4.0
QUEUE_MIN_READY_SCORE=80
GLOBAL_SCAN_INTERVAL_SEC=1200
KEEPALIVE_INTERVAL=50
